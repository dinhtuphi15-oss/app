# Copy file này thành ".env" rồi điền key. Không có key nào cũng chạy được
# (tool sẽ tự bỏ qua nguồn/tính năng tương ứng), nhưng có key thì kết quả
# tốt hơn nhiều.

# --- Bắt buộc để có chất lượng tốt (chuẩn hoá tên riêng, trích thực thể,
# sinh truy vấn tiếng Anh chính xác). Lấy tại https://console.anthropic.com
ANTHROPIC_API_KEY=

# --- Tuỳ chọn: mở thêm nguồn video stock miễn phí
# Pexels: đăng ký free tại https://www.pexels.com/api/
PEXELS_API_KEY=
# Pixabay: đăng ký free tại https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# --- Tuỳ chọn: tìm video CC trên YouTube (cần bật YouTube Data API v3
# trong Google Cloud Console, free quota hàng ngày)
YOUTUBE_API_KEY=
